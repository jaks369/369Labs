# =============================================================================
# REQUIRED — The app will not function without these
# =============================================================================

# MySQL connection string (TiDB Cloud free tier works — see instructions below)
# Get one at: https://tidbcloud.com (free, no credit card)
#   → Sign up → Create Cluster (Starter tier) → Connect → copy connection string
# Example: mysql://user:password@gateway01.us-west-2.prod.aws.tidbcloud.com:4000/test?ssl={"rejectUnauthorized":true}
DATABASE_URL=""

# JWT secret for session signing (generate a random string)
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# 32-byte hex key for encrypting Deriv API tokens at rest
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# =============================================================================
# REQUIRED FOR LIVE TRADING — Settlement verification needs these
# =============================================================================

# Your Deriv API token (for placing real trades and settlement verification)
# Get one at: https://app.deriv.com → Settings → API Token
#   → Check: "Read" and "Trade" scopes → Create → copy the token (starts with "uwyt...")
DERIV_TOKEN=""

# Admin account credentials (used by the live verification harness to log in)
# The OWNER_EMAIL below will auto-promote this user to admin on signup
ADMIN_EMAIL="admin@369labs.com"
ADMIN_PASSWORD="YourPassword123!"

# =============================================================================
# OPTIONAL — Used for specific features
# =============================================================================

# Resend API key for transactional email (password reset, email verification)
# Get one at https://resend.com
RESEND_API_KEY=""

# Google OAuth credentials (for "Login with Google")
# Get them at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth credentials (for "Login with GitHub")
# Get them at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# From address for transactional emails (must be verified in Resend)
EMAIL_FROM="noreply@369labs.com"

# Public-facing URL of your app (used in email links)
APP_URL="http://localhost:3000"

# Email auto-assigned admin role on signup (set this to auto-promote your admin user)
OWNER_EMAIL="admin@369labs.com"

# Deriv App ID for server-side Deriv API access (default is for development)
DERIV_API_APP_ID=""

# AI API key (used by forge; can be any OpenAI-compatible provider)
AI_API_KEY=""
AI_API_BASE_URL="https://api.openai.com/v1"

# RuFlo agent orchestration — falls back to AI_API_KEY/AI_API_BASE_URL when unset
RUFLO_API_KEY=""
RUFLO_API_URL=""
RUFLO_MODEL="gpt-4.1-mini"

# Client-side Deriv WebSocket app ID (from https://app.deriv.com/account/business-data)
VITE_DERIV_APP_ID="33V0MWtYaZLLmAZBWUycN"

# =============================================================================
# STRIPE BILLING (required for live subscription checkout)
# Get keys: https://dashboard.stripe.com/apikeys (sk_test_... for dev)
# =============================================================================
# Secret API key
STRIPE_SECRET_KEY=""
# Webhook signing secret — from https://dashboard.stripe.com/webhooks
# Point the webhook at: <APP_URL>/api/webhooks/stripe and subscribe to:
#   checkout.session.completed, customer.subscription.updated,
#   customer.subscription.created, customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=""
# Recurring price IDs from https://dashboard.stripe.com/prices (set up two "recurring" prices)
# The /subscription page uses STRIPE_PRICE_PRO for "Pro" and STRIPE_PRICE_ENTERPRISE for "Enterprise"
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# =============================================================================
# DEPLOYMENT
# =============================================================================

NODE_ENV="development"
PORT=3000
